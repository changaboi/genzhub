# Uploaded posters are images only: never execute scripts from this folder.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml
AddType text/plain .php .phtml
